{
  "name": "infinite-worlds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/art.ts --quiet",
    "dev": "next dev",
    "prebuild": "tsx scripts/art.ts --quiet",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:worlds": "vitest run tests/worlds tests/evals tests/art",
    "play": "tsx --env-file=.env.local scripts/play.ts",
    "art": "tsx scripts/art.ts",
    "golden": "tsx --env-file=.env.local scripts/golden.ts",
    "invites": "tsx --env-file=.env.local scripts/invites.ts",
    "costs": "tsx --env-file=.env.local scripts/costs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
