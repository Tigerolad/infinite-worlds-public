# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. console.anthropic.com → set a monthly spend limit too (§10).
ANTHROPIC_API_KEY=

# Used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Closed beta. Set to false to open sign-ups without invite codes.
BETA_INVITE_ONLY=true

# Kill switch: no new turns once today's model spend (UTC) reaches this. 0 = off.
DAILY_SPEND_LIMIT_USD=15
# Total API budget; the daily cost check warns at 80% of it.
API_BUDGET_USD=250

# PostHog (optional). Project settings → Project API key. Server only here:
# events are sent from our routes, never from the browser.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
